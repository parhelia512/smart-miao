{
  // 应用设置
  "AppSettings": {
    // 应用监听的HTTP端口号（容器内固定为 8080，与 Dockerfile HEALTHCHECK 一致）
    "HttpPort": 8080,
    // 系统业务基准时区
    "TimeZoneId": "Asia/Shanghai"
  },

  // 数据库连接字符串配置（生产 MySQL）
  "Database": {
    // 默认数据库连接字符串
    "DefaultConnection": "server=192.168.0.88;userid=root;password=123456;port=9504;database=bee_budget;charset=utf8mb4;Allow User Variables=True;Convert Zero Datetime=True;",
    // 默认数据库类型字符串
    "DefaultDbType": "MySql"
  },

  // Redis缓存服务配置（生产 Redis）
  "Redis": {
    // Redis服务器连接字符串（含默认账号与密码）
    "Configuration": "192.168.0.88:6379,password=hFgH6g9VjwYet,user=default",
    // Redis实例名称（可选）
    "InstanceName": "BeeBudget",
    // Redis数据库索引，默认为0
    "DefaultDatabase": 0
  },

  // 健康检查服务配置（与生产 MySQL 相同）
  "HealthChecks": {
    // 健康检查数据库连接字符串
    "DatabaseConnection": "server=192.168.0.88;userid=root;password=123456;port=9504;database=bee_budget_health_checks;charset=utf8mb4;Allow User Variables=True;Convert Zero Datetime=True;",
    // 健康检查 UI 探针地址（容器内访问自身）
    "HealthApiUrl": "http://localhost:8080/health"
  },

  // Hangfire后台任务调度服务配置（与生产 MySQL 相同）
  "Hangfire": {
    "DatabaseConnection": "server=192.168.0.88;userid=root;password=123456;port=9504;database=bee_budget_hangfire;charset=utf8mb4;Allow User Variables=True;Convert Zero Datetime=True;"
  },

  // Token清理服务配置
  "TokenCleanup": {
    "CleanupInterval": 30
  },

  // JWT令牌生成和验证相关的配置（生产环境请修改为强密钥）
  "Jwt": {
    "Key": "aVeryLongSecretKeyThatIsAtLeast32BytesOrCharactersInLength",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "ExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 30
  }
}
